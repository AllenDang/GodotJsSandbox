[configuration]
entry_symbol = "godot_js_runtime_library_init"
compatibility_minimum = "4.3"

[libraries]
macos.debug = "res://bin/macos/libgodot_js_runtime.macos.template_debug.dylib"
macos.release = "res://bin/macos/libgodot_js_runtime.macos.template_release.dylib"
windows.debug.x86_64 = "res://bin/windows/libgodot_js_runtime.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/libgodot_js_runtime.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/linux/libgodot_js_runtime.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/libgodot_js_runtime.linux.template_release.x86_64.so"
